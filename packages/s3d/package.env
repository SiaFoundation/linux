# package settings for s3d, read by scripts/build-deb.sh
# the apt name differs because debian ships an unrelated s3d that owns /usr/bin/s3d
PKG_DEBIAN_NAME=sia-s3d
PKG_CONFLICTS=s3d
PKG_DESCRIPTION="S3-compatible gateway for the Sia network"
PKG_LONG_DESCRIPTION=" s3d translates the AWS S3 API to the Sia storage network. Applications that
 speak S3 can store data on Sia without modification."
PKG_HOMEPAGE=https://github.com/SiaFoundation/s3d
# systemd captures stdout into the journal, so the daemon keeps no second copy
# on disk and writes no color codes into it
PKG_EXEC_ARGS="-log.file.enabled=false -log.stdout.enableANSI=false"
