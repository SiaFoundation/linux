[Unit]
Description=@PKG_NAME@: @PKG_DESCRIPTION@
Documentation=@PKG_HOMEPAGE@
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/@PKG_NAME@@PKG_EXEC_ARGS@
WorkingDirectory=/var/lib/@PKG_NAME@
Restart=always
RestartSec=15
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
